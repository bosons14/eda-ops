{
  "description": "Lint Verilog/SystemVerilog files right after Claude writes or edits them.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/lint_on_edit.py\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
